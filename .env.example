# --- Claude (AI analysis) ---
ANTHROPIC_API_KEY=
PHISHGUARD_LLM_ENABLED=true
PHISHGUARD_LLM_MODEL=claude-opus-5-5
# low | medium | high  - lower is faster and cheaper
PHISHGUARD_LLM_EFFORT=medium
# Share of the final score that comes from the AI verdict (0.0 - 1.0)
PHISHGUARD_LLM_WEIGHT=0.5

# --- Scoring ---
PHISHGUARD_SUSPICIOUS_THRESHOLD=30
PHISHGUARD_PHISHING_THRESHOLD=60

# --- Your organisation ---
# Comma-separated domains you own (skips spoof heuristics for them)
PHISHGUARD_TRUSTED_DOMAINS=
# Extra brand names attackers might impersonate (your company, vendors, bank)
PHISHGUARD_PROTECTED_BRANDS=

# --- Security / alerting ---
# If set, API callers must send header  X-API-Key: <value>
PHISHGUARD_API_KEY=
# Slack/Teams/any webhook that receives JSON alerts for phishing
PHISHGUARD_WEBHOOK_URL=

# --- Mailbox monitor (optional) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60
# Move phishing to a quarantine folder (otherwise just tag + alert)
IMAP_QUARANTINE=false
IMAP_QUARANTINE_FOLDER=Phishing-Quarantine

# --- Outlook add-in / Microsoft AppSource listing ---
# Public HTTPS address of this deployment (used in the add-in manifest)
PHISHGUARD_PUBLIC_BASE_URL=https://app.example.com
# Never change after submitting to Microsoft
PHISHGUARD_ADDIN_ID=4e4a5af4-662a-4c23-996e-1f8d77d1fe65
# Increase for every Partner Center resubmission
PHISHGUARD_ADDIN_VERSION=1.0.0.0
# Must match your verified Partner Center publisher name
PHISHGUARD_PROVIDER_NAME=PhishGuard
PHISHGUARD_SUPPORT_EMAIL=support@example.com
PHISHGUARD_HOSTING_REGION=the United States (us-east-1)
PHISHGUARD_LEGAL_EFFECTIVE_DATE=2026-11-14

# --- Public deployment limits (AI checks for callers without the access key; 0 = unlimited) ---
PHISHGUARD_AI_LIMIT_PER_IP_HOUR=20
PHISHGUARD_AI_LIMIT_PER_DAY=500
